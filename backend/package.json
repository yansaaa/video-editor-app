:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #e7ecff;
  background: #07111f;
  line-height: 1.5;
  font-weight: 400;
  color-scheme: dark;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
}

body {
  background:
    radial-gradient(circle at top, rgba(94, 120, 255, 0.22), transparent 35%),
    #07111f;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: grid;
  grid-template-columns: minmax(300px, 420px) minmax(0, 1fr);
  min-height: 100vh;
  width: min(1300px, calc(100% - 32px));
  margin: 0 auto;
  padding: 32px 0;
  gap: 20px;
}

.panel {
  background: rgba(10, 19, 31, 0.82);
  border: 1px solid rgba(128, 160, 255, 0.18);
  border-radius: 24px;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(18px);
}

.controls {
  padding: 24px;
}

.preview-panel {
  padding: 24px;
}

.panel-header,
.preview-header,
.preset-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.panel-header h1,
.preview-header h2,
.preset-header h3 {
  margin: 0;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(99, 120, 255, 0.14);
  border: 1px solid rgba(140, 164, 255, 0.2);
  color: #9bc4ff;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.controls label {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 18px;
  color: #bfd0ff;
  font-size: 14px;
}

input[type='text'],
select {
  width: 100%;
  background: rgba(15, 28, 42, 0.86);
  color: #edf4ff;
  border: 1px solid rgba(116, 143, 204, 0.25);
  border-radius: 12px;
  padding: 12px 14px;
}

input[type='range'] {
  width: 100%;
}

input[type='color'] {
  width: 100%;
  min-height: 48px;
  border: none;
  border-radius: 12px;
  background: transparent;
}

.field-row {
  display: grid;
  gap: 14px;
}

.two-up {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.value-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  border-radius: 12px;
  background: rgba(15, 28, 42, 0.86);
  border: 1px solid rgba(116, 143, 204, 0.25);
}

.button-group {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

button.primary,
button.secondary,
.preset-item {
  border: none;
  border-radius: 12px;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

button.primary,
button.secondary {
  padding: 12px 16px;
  font-weight: 600;
}

button.primary {
  background: linear-gradient(135deg, #7a8cff, #5ec9ff);
  color: #081622;
}

button.secondary {
  background: rgba(134, 153, 195, 0.14);
  color: #edf4ff;
  border: 1px solid rgba(134, 153, 195, 0.28);
}

button:hover {
  transform: translateY(-1px);
}

.preview-panel {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.video-stage {
  position: relative;
  min-height: 470px;
  overflow: hidden;
  border-radius: 22px;
  border: 1px solid rgba(105, 137, 201, 0.26);
  background:
    linear-gradient(135deg, rgba(36, 60, 93, 0.96), rgba(17, 22, 30, 0.92)),
    url('https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
}

.timeline-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 74px;
  background: rgba(12, 17, 23, 0.76);
  border-top: 1px solid rgba(167, 188, 255, 0.18);
}

.video-overlay {
  position: absolute;
  transform: translate(-50%, -50%);
  max-width: 70%;
  width: max-content;
  text-shadow: 0 14px 18px rgba(0, 0, 0, 0.45);
}

.video-overlay span {
  display: block;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 0.95;
}

.preset-list {
  display: grid;
  gap: 10px;
}

.preset-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  padding: 12px 16px;
  background: rgba(15, 28, 42, 0.86);
  color: #edf4ff;
  border: 1px solid rgba(116, 143, 204, 0.25);
  text-align: left;
}

.preset-item small {
  color: #a6b5d7;
}

@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
    width: min(100% - 24px, 900px);
    padding: 20px 0;
  }
}
